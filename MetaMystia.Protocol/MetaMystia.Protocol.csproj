<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MemoryPack" Version="1.21.4" />
      <PackageReference Include="MinVer" Version="7.0.0">
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="\"/>
      <None Include="..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <PropertyGroup>
        <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>MetaMystia.Protocol</PackageId>
<!--        <Version>1.0.0</Version>  &lt;!&ndash;DON'T FORGET TO INCREMENT ProtocolVersion IN MpConstants.cd WHEN CHANGING MAJOR/MINOR DIGITS&ndash;&gt;-->
        <Authors>Hz6826, MetaMikuAI</Authors>
        <Company>MetaMystia</Company>
        <PackageDescription>Network protocol DTOs for MetaMystia</PackageDescription>
        <RepositoryUrl>https://github.com/MetaMystia/MetaMystia.Protocol</RepositoryUrl>
        <PackageTags>metamystia network dto multiplayer</PackageTags>
    </PropertyGroup>

</Project>
